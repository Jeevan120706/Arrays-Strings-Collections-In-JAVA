import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
       System.out.println("Enter a number");
       Scanner sc = new Scanner(System.in);
       int a = sc.nextInt();
       System.out.println(a);
       int count=0;
       while(a!=1){
        if(a%2==0){
            a=a/2;
            System.out.println(a);
            count++;
        }
        else if(a%2!=0){
            a=3*a+1;
            System.out.println(a);
            count++;
        }
       }
       System.out.println("count:"+count);
    }
}
