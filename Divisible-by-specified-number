import java.io.*;
import java.util.*;

public class Solution {

    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);
        int n = sc.nextInt();
        int num[]= new int[n];
        int count=0;
        int newarr[]= new int[n];
        for(int i=0;i<n;i++){
            num[i]=sc.nextInt();
        }
            int a = sc.nextInt();
            int j=0;
            for(int i=0;i<n;i++){
                
            if(num[i]%a==0){
                
                newarr[j]=num[i];
                count++;
                j++;
            }
        }
        int total=0;
        for(j=0;j<count;j++){
            total = total + newarr[j];
        }
        System.out.print("The elements that are divisible by " + a + " is ");
        for(int i=0;i<count;i++){
             System.out.print(newarr[i]+" ");}
        System.out.println();
        System.out.println("The Count of the value that is divisible by " + a+ " is " + count);
        System.out.println("The Sum of value that is divisible by " + a + " is " + total);
    }
}
