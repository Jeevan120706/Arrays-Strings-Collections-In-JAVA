import java.io.*;
import java.util.*;
public class Solution {
    public static void main(String[] args) {
        Scanner sc= new Scanner(System.in);
        int n=6;                                
        int arr[]= new int[n];
        for(int x=0;x<n;x++){
            arr[x] = sc.nextInt();
        }                                   
        int k=sc.nextInt();
        for(int i=0;i<=n-k;i++){
            int max=0;                  
            for(int j=i;j<i+k;j++){ 
                if(arr[j]>max){     
                max=arr[j];     
                }           
            }                     
        System.out.print(max+" ");
        }  
    }             
}    
